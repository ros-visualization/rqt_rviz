<?xml version="1.0"?>
<package format="2">
  <name>rqt_rviz</name>
  <version>0.7.2</version>
  <description>rqt_rviz provides a GUI plugin embedding <a href = "http://www.ros.org/wiki/rviz">RViz</a>.
    Note that this rqt plugin does NOT supersede RViz but depends on it.
  </description>
  <maintainer email="rhaschke@techfak.uni-bielefeld.de">Robert Haschke</maintainer>
  <maintainer email="louise@osrfoundation.org">Louise Poubel</maintainer>

  <license>BSD</license>

  <url type="website">http://wiki.ros.org/rqt_rviz</url>
  <url type="repository">https://github.com/ros-visualization/rqt_rviz</url>
  <url type="bugtracker">https://github.com/ros-visualization/rqt_rviz/issues</url>

  <author>Dorian Scholz</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>libboost-program-options-dev</build_depend>
  <!-- Qt is transitively required from rviz_common -->

  <build_depend>pluginlib</build_depend>
  <build_depend>qt_gui_cpp</build_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>rviz_rendering</build_depend>

  <depend>rqt_gui_cpp</depend>
  <depend>rviz_common</depend>

  <exec_depend>libboost-program-options</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>qt_gui_cpp</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>rviz_rendering</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>
